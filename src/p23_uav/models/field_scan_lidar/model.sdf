<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="field_scan_lidar">
    <link name="link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>2.17e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.17e-6</iyy>
          <iyz>0</iyz>
          <izz>1.8e-7</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Black</name>
          </script>
        </material>
      </visual>
      <sensor name="field_scan_laser" type="ray">
        <!-- Pitch 90 deg down (1.5707963 rad) -->
        <pose>0 0 0 0 1.5707963 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-0.5236</min_angle>
              <max_angle>0.5236</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.3</min>
            <max>25.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <plugin name="field_scan_pointcloud" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/uav/lidar</namespace>
            <remapping>~/out:=points</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>field_scan_lidar_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
