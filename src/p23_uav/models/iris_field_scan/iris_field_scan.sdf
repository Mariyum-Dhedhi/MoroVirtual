<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='iris_field_scan'>
    <include>
      <uri>model://iris</uri>
    </include>
    <include>
      <uri>model://field_scan_lidar</uri>
      <pose>0 0 -0.05 0 0 0</pose>
