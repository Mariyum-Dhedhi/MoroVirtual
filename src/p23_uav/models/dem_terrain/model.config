<?xml version="1.0"?>
<model>
  <name>dem_terrain</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Generated from DEM/orthophoto (230526)</name>
  </author>

  <description>
    Static terrain model generated from a drone survey DEM (230526_DEM.tif) and
    orthophoto (230526_ortho.tif), UTM zone 32N, original 3cm/px resolution.
    Mesh downsampled to a 300x110 grid (~0.58 m spacing) for real-time simulation,
    with the orthophoto draped as the diffuse texture via UV mapping.
    Local origin is centered on the survey footprint; Z=0 corresponds to the
    minimum elevation in the source DEM (221.22 m in the original UTM/vertical datum).
  </description>
</model>
