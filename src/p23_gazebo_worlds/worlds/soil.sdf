<?xml version="1.0"?>
<!--
  P23 Agricultural UGV – Soil World
  Gazebo Fortress (Ignition Gazebo 6) / SDF 1.8

  Empty field with:
    • Tilled-soil ground plane (200 × 200 m)
    • Realistic directional sunlight + soft sky ambient
    • Physics, UserCommands and SceneBroadcaster system plugins (minimum required)
-->
<sdf version="1.8">
  <world name="soil_world">

    <!-- ================================================================
         SPHERICAL COORDINATES  –  georeference origin for NavSat sensors
         Required for ignition-gazebo-navsat-system to convert the robot's
         local ENU pose into lat/lon/alt. Without this tag, NavSat publishes
         a fixed fix that does not change as the robot moves.
         Arbitrary origin (example: a field near Lahore, Pakistan).
    ================================================================ -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>50.6259768055</latitude_deg>
      <longitude_deg>6.9836962966</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ================================================================
         PHYSICS
    ================================================================ -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ================================================================
         IGNITION GAZEBO FORTRESS  –  REQUIRED SYSTEM PLUGINS
    ================================================================ -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>

    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>

    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- Contact detection (needed for wheel-ground interaction) -->
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>

    <!-- IMU sensor simulation -->
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <!-- GNSS / NavSat sensor simulation -->
    <plugin filename="ignition-gazebo-navsat-system"
            name="ignition::gazebo::systems::NavSat"/>

    <!-- Camera + GPU LiDAR sensor simulation (requires ogre2 render engine) -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ================================================================
         SCENE  (background sky colour + ambient)
    ================================================================ -->
    <scene>
      <sky/>
      <ambient>0.40 0.38 0.34 1.0</ambient>
      <background>0.55 0.68 0.82 1.0</background>
      <shadows>false</shadows>
    </scene>

    <!-- ================================================================
         LIGHTING  –  mid-morning agricultural sun
    ================================================================ -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <!-- warm sunlight -->
      <diffuse>0.95 0.90 0.78 1.0</diffuse>
      <specular>0.30 0.28 0.24 1.0</specular>
      <!-- direction: slightly south-east, well above horizon -->
      <direction>-0.50 0.20 -0.85</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.90</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- ================================================================
         GROUND PLANE  –  field orthophoto (230613_ortho.png) as a flat
         ground texture. Plane sized to the photo's real-world extent so
         the image maps 1:1 without stretching.
    ================================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <pose>84.355 14.4 0 0 0 0</pose>
      <!-- <pose>84.5 14.35 0 0 0 0</pose> -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>175.14 63.93</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- typical compacted soil friction -->
                <mu>0.80</mu>
                <mu2>0.60</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1e6</kp>
                <kd>100</kd>
              </ode>
            </contact>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>175.14 63.93</size>
            </plane>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1.0</ambient>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
            <specular>0.02 0.02 0.02 1.0</specular>
            <pbr>
              <metal>
                <albedo_map>model://p23_gazebo_worlds/models/230607_ortho.png</albedo_map>
                <roughness>0.9</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>

      </link>
    </model>

    <!-- ================================================================
         PLANT PLOTS  –  replicated UGV-LMI point cloud canopy meshes.
         Each plant_plotXXX model represents one plant/crop type's canopy
         scan, sized to a single 6 x 8 m plot footprint (local origin at
         corner (0,0), local long axis +Y, centroid at local (3,4)).
         It is instantiated once per physical plot cell it's assigned to,
         each with its own pose: rotate by (that plot's long-edge heading
         - 90 deg), then offset so the mesh's centroid (not its local
         origin) lands on that plot's corner centroid (from
         plot_corners_local.json) — same frame as the corner_marker_*
         markers and this world's spherical_coordinates DATUM.
    ================================================================ -->
    <!-- plant_plot178 instances (all but p238 disabled) -->
    <include>
      <name>plant_plot178_p178</name>
      <uri>model://p23_gazebo_worlds/models/plant_plot178</uri>
      <pose>27.3304 30.4181 -0.0500 0 0 -0.095003</pose>
    </include>
