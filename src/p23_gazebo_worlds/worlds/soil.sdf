    <!-- ================================================================
         WAYPOINT MARKERS 0-29  -  regenerated from outputs/waypoints.csv
         Color by point_type: entry/overshoot=orange, row_start/row_end=red,
         headland=green
    ================================================================ -->
    <!-- <model name="waypoint_marker_0">
