<?xml version="1.0"?>
<model>
  <name>simple_rover</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Minimal differential-drive rover with real physics (mass, inertia,
    friction, gravity), a diff-drive plugin, and a GPS/NavSat sensor already
    wired in. Use this to test-drive the phenorob_field world before your
    own robot model is ready.
  </description>
</model>
