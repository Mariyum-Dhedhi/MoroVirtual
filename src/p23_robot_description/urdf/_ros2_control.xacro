<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       ros2_control hardware interface for Gazebo Fortress (gz_ros2_control)

       Steer joints  → position command interface  (±π/2 rad)
       Drive joints  → velocity command interface  (rad/s)
  ================================================================ -->

  <ros2_control name="GazeboSimSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- ── Steering joints (position-controlled) ──────────────────── -->
    <joint name="front_left_steer_joint">
      <command_interface name="position">
        <param name="min">${-pi/2.0}</param>
        <param name="max">${ pi/2.0}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_steer_joint">
      <command_interface name="position">
        <param name="min">${-pi/2.0}</param>
        <param name="max">${ pi/2.0}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_steer_joint">
      <command_interface name="position">
        <param name="min">${-pi/2.0}</param>
        <param name="max">${ pi/2.0}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_steer_joint">
      <command_interface name="position">
        <param name="min">${-pi/2.0}</param>
        <param name="max">${ pi/2.0}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- ── Drive joints (velocity-controlled) ─────────────────────── -->
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <!-- gz_ros2_control Gazebo plugin — loads controllers.yaml at startup -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find p23_bringup)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
