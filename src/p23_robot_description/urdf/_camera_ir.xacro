<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       IR / THERMAL CAMERA  (e.g. FLIR Boson 640)
       Used for crop-health monitoring.  Pitched 30° downward so the
       field of view covers the canopy directly ahead of the robot.
       Carries a REP-104 optical frame child link.

       Height from base_link origin:
         IR camera centre  top_z + sz/2 = 0.250 + 0.035 = 0.285 m
  ================================================================ -->

  <xacro:sensor_cylinder name="camera_ir"
    parent="imu_link"
    x="0" y="0" z="-0.07"
    roll="0" pitch="0" yaw="0"
    r="${0.050*2}" h="${0.05}"
    m="0.30" mat="ir_orange"/>
  <xacro:optical_frame name="camera_ir"/>

</robot>
